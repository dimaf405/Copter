# setup SERIAL3 for ADSB
SERIAL3_BAUD 115
SERIAL3_PROTOCOL 2

# BMS protocol
SERIAL5_PROTOCOL 50
SERIAL5_BAUD 115

# setup batt
BATT_MONITOR 28

# setup WS2812 on PA8/S6
SERVO6_FUNCTION 120
NTF_LED_TYPES 257
NTF_LED_LEN 1

ADSB_TYPE 1
ADSB_LIST_MAX 50
ADSB_LIST_RADIUS 100000

SR0_SR0_ADSB 5

# EKF replay logging
LOG_REPLAY 0
LOG_DISARMED 1
LOG_BACKEND_TYPE 1
# The onboard 1-Gbit SD NAND has about 128 MiB total capacity.
LOG_FILE_MB_FREE 10
